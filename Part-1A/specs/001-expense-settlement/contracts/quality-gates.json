{
  "version": 1,
  "runner": ".harness/harness.js",
  "gates": [
    {
      "id": "lint-guard",
      "name": "Lint Guard",
      "required": true,
      "command": "npm run lint",
      "failOnNonZero": true
    },
    {
      "id": "security-sast-guard",
      "name": "Security/SAST Guard",
      "required": true,
      "command": "semgrep scan --config .harness/semgrep.yml --error .",
      "failOnNonZero": true
    },
    {
      "id": "contract-unit-test",
      "name": "Contract/Unit Test",
      "required": true,
      "command": "node --test tests/app.test.js",
      "failOnNonZero": true
    }
  ],
  "reportPath": "evidence/harness-results.json"
}
